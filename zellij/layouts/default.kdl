layout {
  default_tab_template {
    children
    pane size=1 borderless=true {
      plugin location="zjstatus" {
        command_tab_sync_command "zellij status-bar --syntax-check"
        format_space "#[bg=#181825]"
        format_left   "#[bg=#181825]{mode}"
        format_center "#[bg=#181825]{tabs}"
        format_right  "#[bg=#181825]{session}"
        border_enabled  "false"
        hide_frame_for_single_pane "true"
        mode_normal        "#[bg=#89b4fa,fg=#181825,bold]   NORMAL #[fg=#89b4fa,bg=#181825]"
        mode_locked        "#[bg=#f38ba8,fg=#181825,bold]   LOCKED #[fg=#f38ba8,bg=#181825]"
        mode_resize        "#[bg=#fab387,fg=#181825,bold]   RESIZE #[fg=#fab387,bg=#181825]"
        mode_pane          "#[bg=#cba6f7,fg=#181825,bold]   PANE #[fg=#cba6f7,bg=#181825]"
        mode_tab           "#[bg=#b4befe,fg=#181825,bold]   TAB #[fg=#b4befe,bg=#181825]"
        mode_scroll        "#[bg=#eba0ac,fg=#181825,bold]   SCROLL #[fg=#eba0ac,bg=#181825]"
        mode_entersearch   "#[bg=#f9e2af,fg=#181825,bold]   ENTER SEARCH #[fg=#f9e2af,bg=#181825]"
        mode_search        "#[bg=#f9e2af,fg=#181825,bold]   SEARCH #[fg=#f9e2af,bg=#181825]"
        mode_renametab     "#[bg=#a6e3a1,fg=#181825,bold]   RENAME TAB #[fg=#a6e3a1,bg=#181825]"
        mode_renamepane    "#[bg=#a6e3a1,fg=#181825,bold]   RENAME PANE #[fg=#a6e3a1,bg=#181825]"
        mode_session       "#[bg=#94e2d5,fg=#181825,bold]   SESSION #[fg=#94e2d5,bg=#181825]"
        mode_move          "#[bg=#f5c2e7,fg=#181825,bold]   MOVE #[fg=#f5c2e7,bg=#181825]"
        mode_tmux          "#[bg=#cdd6f4,fg=#181825,bold]   TMUX #[fg=#cdd6f4,bg=#181825]"
        tab_active         "#[fg=#89b4fa,bg=#181825,bold]{name}{sync_indicator}{fullscreen_indicator}{floating_indicator} "
        tab_active_fullscreen "#[fg=#89b4fa,bg=#181825,bold]{name}{fullscreen_indicator} "
        tab_active_sync        "#[fg=#89b4fa,bg=#181825,bold]{name}{sync_indicator} "
        tab_active_floating   "#[fg=#89b4fa,bg=#181825,bold]{name}{floating_indicator} "
        tab_normal           "#[fg=#6c7086,bg=#181825]{name}{sync_indicator}{fullscreen_indicator}{floating_indicator} "
        tab_normal_fullscreen "#[fg=#6c7086,bg=#181825]{name}{fullscreen_indicator} "
        tab_normal_sync       "#[fg=#6c7086,bg=#181825]{name}{sync_indicator} "
        tab_normal_floating "#[fg=#6c7086,bg=#181825]{name}{floating_indicator} "
        tab_sync_indicator        "  "
        tab_fullscreen_indicator "  "
        tab_floating_indicator  "  "
        tab_separator           "#[fg=#6c7086,bg=#181825]- "
      }
    }
  }

  tab name="nvim" focus=true cwd="~/Developer" {
    pane command="nvim" {
      args "-c" "NvimTreeToggle"
    }
  }

  tab name="dotfiles" cwd="~/Developer/dotfiles" {
    pane command="nvim" {
      args "-c" "NvimTreeToggle"
    }
  }

  tab name="opencode" cwd="~/Developer" {
    pane command="opencode"
  }

  tab name="yazi" cwd="~/Developer" {
    pane command="yazi"
  }

  tab name="lazygit" cwd="~/Developer/dotfiles" {
    pane command="lazygit"
  }

  tab name="shell" cwd="~/Developer/dotfiles"

  tab name="claude" cwd="~/Developer" {
    pane command="claude" {
      args "code"
    }
  }

  tab name="lazydocker" cwd="~/Developer" {
    pane command="lazydocker"
  }
}
