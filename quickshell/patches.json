  "sethen.workspaces": {
    "glyphs": {},
    "edits": [
      {
        "file": "Workspaces.qml",
        "note": "draw the icon in SethensSuperCode; three workspace states: focused, occupied, empty",
        "find": "        text: focused ? \"\\uDB85\\uDCFB\" : (modelData === 10 ? \"0\" : String(modelData))",
        "replace": "        // Three states, three glyphs from SethensSuperCode: ringed square\n        // focused, filled occupied, hollow empty. No state renders a number\n        // any more, so the font needs no digit fallback and the old\n        // workspace-10 \"0\" case is gone with it.\n        text: focused ? \"\\uf04b\" : (occupied ? \"\\uf04a\" : \"\\uf04c\")\n        fontFamily: \"SethensSuperCode\""
      }
    ]
