        "replace": "  // Our glyphs, chosen here rather than inside Model.js so that file stays a\n  // symlink to omarchy's copy and keeps tracking upstream. Wi-Fi and\n  // ethernet share one glyph, matching the old waybar format-icons.\n  readonly property string icon: kind === \"disconnected\" ? \"\" : \"\""
      },
