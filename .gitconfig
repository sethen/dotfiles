[core]
  editor = nvim
  excludesfile = ~/.gitignore_global
[push]
  default = simple
[pull]
  rebase = true
[init]
  defaultBranch = main
# Personal identity (user name/email, github user) is generated per-machine by
# configure-user and lives here; keeps this committed config identity-free.
[include]
  path = ~/.gitconfig.local
