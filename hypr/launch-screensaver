#!/bin/bash

# omarchy-launch-screensaver only knows alacritty, foot, ghostty and kitty: it picks
# a branch from `xdg-terminal-exec --print-id`, so with wezterm as the default
# terminal it notifies and does nothing. Same screensaver, run in alacritty.

command -v tte >/dev/null 2>&1 || exit 1
pgrep -f org.omarchy.screensaver >/dev/null 2>&1 && exit 0
omarchy-toggle-enabled screensaver-off && [ "$1" != force ] && exit 1

walker -q 2>/dev/null

focused=$(omarchy-hyprland-monitor-focused)

for monitor in $(hyprctl monitors -j | jq -r '.[] | .name'); do
    hyprctl dispatch focusmonitor "$monitor"
    hyprctl dispatch exec -- alacritty --class=org.omarchy.screensaver \
        --config-file ~/.local/share/omarchy/default/alacritty/screensaver.toml \
        -e omarchy-screensaver
done

hyprctl dispatch focusmonitor "$focused"
